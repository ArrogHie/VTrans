{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTrans",
  "version": "0.1.0",
  "identifier": "com.vtrans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VTrans",
        "width": 420,
        "height": 600,
        "resizable": true,
        "center": true
      },
      {
        "label": "result",
        "title": "VTrans Result",
        "width": 400,
        "height": 300,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
