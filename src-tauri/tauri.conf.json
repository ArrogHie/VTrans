{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTrans",
  "version": "0.1.0",
  "identifier": "com.vtrans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VTrans",
        "width": 420,
        "height": 600,
        "resizable": true,
        "center": true
      },
      {
        "label": "result",
        "title": "VTrans Result",
        "width": 360,
        "height": 140,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true
      },
      {
        "label": "selector",
        "title": "Select Region",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "VTrans Region Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "floater",
        "title": "VTrans Floater",
        "width": 48,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
